{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "website/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/create-order",
      "dest": "api/index.js"
    },
    {
      "src": "/verify-payment",
      "dest": "api/index.js"
    },
    {
      "src": "/payment-status",
      "dest": "api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/website/$1"
    }
  ]
}
